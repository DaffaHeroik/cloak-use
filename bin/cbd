#!/usr/bin/env python3
"""cbd — daemon CDP persistent buat browser agent.

Masalah yang dipecahin: `cb` pakai Playwright yang tiap panggilan nyalain
driver Node (~337ms). Raw CDP websocket cuma ~0.2ms per RPC. Jadi daemon ini
pegang SATU koneksi websocket permanen ke tab aktif, dan client (`cbf`)
tinggal nitip perintah lewat unix socket.

Socket: /run/cbd.sock  (fallback /tmp/cbd.sock)
Log   : ~/.cloak-use/cbd.log (override: env CBD_LOG)
"""
import base64
import json
import os
import socket
import sys
import threading
import time
import urllib.request

CDP = os.environ.get("CB_CDP", "http://127.0.0.1:9222")
SOCK = os.environ.get("CBD_SOCK", "/run/cbd.sock")
if not os.access(os.path.dirname(SOCK), os.W_OK):
    SOCK = "/tmp/cbd.sock"
LOG = os.environ.get("CBD_LOG", os.path.join(os.path.expanduser("~"), ".cloak-use", "cbd.log"))


def log(msg):
    try:
        with open(LOG, "a") as f:
            f.write(f"{time.strftime('%H:%M:%S')} {msg}\n")
    except Exception:
        pass


class CDPConn:
    """Satu koneksi websocket ke satu target page, dengan auto-reconnect."""

    def __init__(self):
        self.ws = None
        self.wid = 0
        self.target_id = None
        self.lock = threading.Lock()
        self.reconnects = 0

    # ---------- target discovery ----------
    def _targets(self):
        with urllib.request.urlopen(CDP + "/json", timeout=3) as r:
            return json.loads(r.read().decode())

    def _pages(self):
        return [t for t in self._targets()
                if t.get("type") == "page" and not t.get("url", "").startswith("devtools://")]

    def pick_target(self, want=None):
        """want: index (int) atau substring url. None = tab pertama."""
        pages = self._pages()
        if not pages:
            raise RuntimeError("tidak ada tab page di browser")
        if isinstance(want, int):
            if want >= len(pages):
                raise RuntimeError(f"tab index {want} tidak ada (total {len(pages)})")
            return pages[want]
        if isinstance(want, str) and want:
            for p in pages:
                if want in p.get("url", ""):
                    return p
        return pages[0]

    # ---------- connection ----------
    def connect(self, want=None):
        from websocket import create_connection
        t = self.pick_target(want)
        self.target_id = t["id"]
        self.ws = create_connection(t["webSocketDebuggerUrl"], timeout=20,
                                    max_size=None, suppress_origin=True)
        self.ws.settimeout(20)
        return t

    def ensure(self, want=None):
        with self.lock:
            if self.ws is None:
                self.connect(want)
                return
            # cek tab masih hidup
            try:
                pages = self._pages()
                if not any(p["id"] == self.target_id for p in pages):
                    log("target hilang, reconnect")
                    self.connect(want)
            except Exception:
                try:
                    self.connect(want)
                except Exception as e:
                    raise RuntimeError(f"browser tidak bisa dihubungi: {e}")

    def close(self):
        try:
            if self.ws:
                self.ws.close()
        except Exception:
            pass
        self.ws = None

    # ---------- rpc ----------
    def rpc(self, method, timeout=20, **params):
        with self.lock:
            if self.ws is None:
                self.connect()
            self.wid += 1
            mid = self.wid
            self.ws.send(json.dumps({"id": mid, "method": method, "params": params}))
            deadline = time.time() + timeout
            while time.time() < deadline:
                try:
                    self.ws.settimeout(max(0.1, deadline - time.time()))
                    raw = self.ws.recv()
                except Exception as e:
                    self.close()
                    raise RuntimeError(f"koneksi CDP putus: {e}")
                if not raw:
                    self.close()
                    raise RuntimeError("koneksi CDP ditutup browser")
                try:
                    m = json.loads(raw)
                except Exception:
                    continue
                if m.get("id") != mid:
                    continue          # event / respons lain, buang
                if "error" in m:
                    raise RuntimeError(m["error"].get("message", str(m["error"])))
                return m.get("result", {})
            raise RuntimeError(f"timeout {timeout}s nunggu {method}")

    # ---------- helpers ----------
    def eval(self, expr, await_promise=True):
        r = self.rpc("Runtime.evaluate", expression=expr,
                     returnByValue=True, awaitPromise=await_promise,
                     userGesture=True)
        res = r.get("result", {})
        if r.get("exceptionDetails"):
            d = r["exceptionDetails"]
            raise RuntimeError("JS error: " + str(d.get("exception", {}).get("description", d.get("text"))))
        return res.get("value")

    def nav_state(self):
        return self.eval("document.readyState")


CONN = CDPConn()


# ================= command handlers =================
def _sel(sel):
    return json.dumps(sel)


def cmd_eval(a):
    return {"value": CONN.eval(a["expr"])}


def cmd_goto(a):
    url = a["url"]
    timeout = a.get("timeout", 30)
    CONN.rpc("Page.enable")
    CONN.rpc("Page.navigate", url=url)
    # tunggu readyState interaktif/complete — polling cepat, bukan sleep buta
    deadline = time.time() + timeout
    last = None
    while time.time() < deadline:
        try:
            last = CONN.nav_state()
        except Exception:
            pass
        if last == "complete":
            break
        if last == "interactive" and not a.get("wait_complete", True):
            break
        time.sleep(0.03)
    title = CONN.eval("document.title") or ""
    return {"url": CONN.eval("location.href"), "title": title,
            "readyState": last, "ms_waited": round(timeout - max(0, deadline - time.time()), 3)}


def cmd_text(a):
    sel = a.get("sel") or "body"
    js = (f"(()=>{{const e=document.querySelector({_sel(sel)});"
          f"return e?(e.innerText||e.textContent||''):''}})()")
    v = CONN.eval(js) or ""
    return {"text": v[:a.get("max", 8000)], "len": len(v)}


def cmd_html(a):
    sel = a.get("sel") or "body"
    js = (f"(()=>{{const e=document.querySelector({_sel(sel)});"
          f"return e?e.innerHTML:''}})()")
    v = CONN.eval(js) or ""
    return {"html": v[:a.get("max", 20000)], "len": len(v)}


def cmd_click(a):
    sel = a["sel"]
    if a.get("real"):
        # klik beneran lewat Input domain (buat elemen yang butuh event mouse asli)
        box = CONN.eval(f"(()=>{{const e=document.querySelector({_sel(sel)});"
                        f"if(!e)return null;const r=e.getBoundingClientRect();"
                        f"return {{x:r.x+r.width/2,y:r.y+r.height/2}}}})()")
        if not box:
            raise RuntimeError(f"elemen tidak ketemu: {sel}")
        x, y = box["x"], box["y"]
        for t in ("mousePressed", "mouseReleased"):
            CONN.rpc("Input.dispatchMouseEvent", type=t, x=x, y=y,
                     button="left", clickCount=1)
        return {"clicked": sel, "at": [round(x), round(y)], "mode": "real"}
    ok = CONN.eval(f"(()=>{{const e=document.querySelector({_sel(sel)});"
                   f"if(!e)return false;e.click();return true}})()")
    if not ok:
        raise RuntimeError(f"elemen tidak ketemu: {sel}")
    return {"clicked": sel, "mode": "js"}


def cmd_fill(a):
    sel, val = a["sel"], a["val"]
    ok = CONN.eval(
        "(()=>{const e=document.querySelector(%s);if(!e)return false;"
        "const v=%s;e.focus();"
        "const proto=e instanceof HTMLTextAreaElement?HTMLTextAreaElement.prototype:HTMLInputElement.prototype;"
        "const d=Object.getOwnPropertyDescriptor(proto,'value');"
        "if(d&&d.set){d.set.call(e,v)}else{e.value=v}"
        "e.dispatchEvent(new Event('input',{bubbles:true}));"
        "e.dispatchEvent(new Event('change',{bubbles:true}));"
        "return true})()" % (_sel(sel), json.dumps(val)))
    if not ok:
        raise RuntimeError(f"elemen tidak ketemu: {sel}")
    return {"filled": sel, "len": len(val)}


def cmd_press(a):
    key = a["key"]
    mapping = {"Enter": (13, "Enter"), "Tab": (9, "Tab"), "Escape": (27, "Escape"),
               "Backspace": (8, "Backspace"), "ArrowDown": (40, "ArrowDown"),
               "ArrowUp": (38, "ArrowUp"), "ArrowLeft": (37, "ArrowLeft"),
               "ArrowRight": (39, "ArrowRight"), " ": (32, "Space")}
    code, k = mapping.get(key, (0, key))
    for t in ("keyDown", "keyUp"):
        CONN.rpc("Input.dispatchKeyEvent", type=t, key=k, code=k,
                 windowsVirtualKeyCode=code, nativeVirtualKeyCode=code)
    return {"pressed": key}


def cmd_tabs(a):
    pages = CONN._pages()
    return {"tabs": [{"i": i, "id": p["id"], "title": p.get("title", ""),
                      "url": p.get("url", "")[:140]} for i, p in enumerate(pages)],
            "active": CONN.target_id}


def cmd_newtab(a):
    url = a.get("url") or "about:blank"
    r = CONN.rpc("Target.createTarget", url=url)
    time.sleep(0.1)
    CONN.connect(r["targetId"])
    return {"created": r["targetId"], "url": url}


def cmd_target(a):
    want = a.get("want")
    t = CONN.connect(want)
    return {"target": t["id"], "url": t.get("url", "")[:140], "title": t.get("title", "")}


def cmd_shot(a):
    r = CONN.rpc("Page.captureScreenshot", format=a.get("fmt", "png"),
                 captureBeyondViewport=False, timeout=25)
    data = base64.b64decode(r["data"])
    path = a.get("path") or "/tmp/cbd_shot.png"
    with open(path, "wb") as f:
        f.write(data)
    return {"path": path, "bytes": len(data)}


def cmd_title(a):
    return {"title": CONN.eval("document.title"), "url": CONN.eval("location.href")}


def cmd_wait(a):
    """Tunggu kondisi: selector muncul, atau teks muncul."""
    deadline = time.time() + a.get("timeout", 10)
    sel = a.get("sel")
    while time.time() < deadline:
        if sel:
            if CONN.eval(f"!!document.querySelector({_sel(sel)})"):
                return {"found": sel, "ok": True}
        else:
            if CONN.eval("document.readyState") == "complete":
                return {"ok": True}
        time.sleep(0.03)
    return {"ok": False, "timeout": a.get("timeout", 10)}


def cmd_ping(a):
    return {"pong": True, "target": CONN.target_id, "reconnects": CONN.reconnects}


HANDLERS = {
    "eval": cmd_eval, "goto": cmd_goto, "text": cmd_text, "html": cmd_html,
    "click": cmd_click, "fill": cmd_fill, "press": cmd_press, "tabs": cmd_tabs,
    "newtab": cmd_newtab, "target": cmd_target, "shot": cmd_shot,
    "title": cmd_title, "wait": cmd_wait, "ping": cmd_ping,
}


# ================= server =================
def handle(req):
    cmd = req.get("cmd")
    fn = HANDLERS.get(cmd)
    if not fn:
        return {"ok": False, "error": f"command tidak dikenal: {cmd}"}
    try:
        out = fn(req)
        out["ok"] = True
        return out
    except Exception as e:
        return {"ok": False, "error": str(e)}


def serve():
    if os.path.exists(SOCK):
        os.unlink(SOCK)
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(SOCK)
    os.chmod(SOCK, 0o600)
    srv.listen(16)
    log(f"listening {SOCK} cdp={CDP}")

    # warm up: konek sekali biar command pertama nggak bayar handshake
    try:
        t = CONN.connect()
        CONN.rpc("Page.enable")
        CONN.rpc("Runtime.enable")
        log(f"warm: {t.get('url','')[:80]}")
    except Exception as e:
        log(f"warm gagal: {e}")

    while True:
        try:
            conn, _ = srv.accept()
        except Exception as e:
            log(f"accept error: {e}")
            continue
        threading.Thread(target=client, args=(conn,), daemon=True).start()


def client(conn):
    try:
        conn.settimeout(60)
        buf = b""
        while True:
            chunk = conn.recv(65536)
            if not chunk:
                break
            buf += chunk
            if b"\n" not in buf:
                continue
            line, buf = buf.split(b"\n", 1)
            if not line.strip():
                continue
            try:
                req = json.loads(line.decode())
            except Exception as e:
                conn.sendall((json.dumps({"ok": False, "error": f"json invalid: {e}"}) + "\n").encode())
                continue
            out = handle(req)
            conn.sendall((json.dumps(out, ensure_ascii=False) + "\n").encode())
    except Exception as e:
        log(f"client error: {e}")
    finally:
        try:
            conn.close()
        except Exception:
            pass


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "--check":
        print("SOCK", SOCK, "CDP", CDP)
        sys.exit(0)
    serve()
